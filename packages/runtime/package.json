{
  "name": "@aprovan/runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared UTDK sandbox runtime: namespace proxies, gateway transport, execution policy, and browser sandbox for scripts and widgets",
  "keywords": ["utdk", "sandbox", "runtime", "gateway", "proxy"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aprovan/tsconfig": "^0.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
