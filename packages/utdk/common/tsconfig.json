{
  "extends": "../../../config/tsconfig/node.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "types": ["node"],
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
