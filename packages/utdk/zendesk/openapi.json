{
  "openapi": "3.0.3",
  "info": {
    "title": "Zendesk Support API",
    "version": "2.0.0",
    "description": "The Zendesk Support API lets you access, create, update, and delete help desk tickets (called 'tickets'), users, organizations, and groups. Build integrations that automate support workflows, sync customer data, and extend the Zendesk platform.",
    "contact": {
      "name": "Zendesk Developer Support",
      "url": "https://developer.zendesk.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-logo": {
      "url": "https://d1eipm3vz40hy0.cloudfront.net/images/logos/zendesk-logo.svg"
    }
  },
  "externalDocs": {
    "description": "Zendesk API Reference",
    "url": "https://developer.zendesk.com/api-reference"
  },
  "servers": [
    {
      "url": "https://{subdomain}.zendesk.com/api/v2",
      "variables": {
        "subdomain": {
          "default": "example",
          "description": "Your Zendesk subdomain"
        }
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/tickets": {
      "get": {
        "operationId": "listTickets",
        "summary": "List tickets",
        "description": "Returns a list of all tickets in the Zendesk account. Tickets are sorted by creation date in descending order by default. Use pagination parameters to retrieve large result sets.",
        "tags": [
          "Tickets"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of tickets per page (max 100)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Field to sort results by",
            "schema": {
              "type": "string",
              "enum": [
                "created_at",
                "updated_at",
                "priority",
                "status",
                "ticket_type"
              ]
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Sort direction",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of tickets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createTicket",
        "summary": "Create a ticket",
        "description": "Create a new support ticket. You can set the subject, description, priority, type, requester, assignee, tags, and custom fields. A ticket must have at minimum a subject or description.",
        "tags": [
          "Tickets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTicketRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/tickets/{ticketId}": {
      "get": {
        "operationId": "getTicket",
        "summary": "Show a ticket",
        "description": "Returns the details of a specific ticket by its ID, including subject, description, status, priority, requester, assignee, tags, and custom field values.",
        "tags": [
          "Tickets"
        ],
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "description": "The ticket ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "operationId": "updateTicket",
        "summary": "Update a ticket",
        "description": "Update one or more properties of a ticket. You can change the subject, status, priority, assignee, tags, and other fields. Only include the fields you want to change.",
        "tags": [
          "Tickets"
        ],
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "description": "The ticket ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTicketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      },
      "delete": {
        "operationId": "deleteTicket",
        "summary": "Delete a ticket",
        "description": "Permanently delete a ticket and all its associated comments. This action cannot be undone. Deleted tickets are moved to the account's deleted tickets list for 30 days before permanent deletion.",
        "tags": [
          "Tickets"
        ],
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "description": "The ticket ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Ticket deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/tickets/{ticketId}/comments": {
      "get": {
        "operationId": "listTicketComments",
        "summary": "List ticket comments",
        "description": "Returns all comments on a ticket, including public replies and internal notes. Comments are sorted by creation date in ascending order.",
        "tags": [
          "Tickets"
        ],
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "description": "The ticket ID",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Comments per page",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of comments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentList"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List users",
        "description": "Returns a list of users in the account. Includes end-users (customers), agents, and administrators. Use filters to narrow results by role or organization.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "description": "Filter by user role",
            "schema": {
              "type": "string",
              "enum": [
                "end-user",
                "agent",
                "admin"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserList"
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "summary": "Show a user",
        "description": "Returns the profile of a specific user including their name, email, role, organization membership, and custom user fields.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The user ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/organizations": {
      "get": {
        "operationId": "listOrganizations",
        "summary": "List organizations",
        "description": "Returns all organizations in the account. Organizations group users together and can be used to manage shared tickets and visibility rules.",
        "tags": [
          "Organizations"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of organizations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationList"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "search",
        "summary": "Search Zendesk",
        "description": "Search tickets, users, organizations, groups, and other Zendesk objects using Zendesk's search syntax. Supports filtering by field values, date ranges, and full-text search.",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search query using Zendesk search syntax (e.g. 'type:ticket status:open priority:high')",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Field to sort results by",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Sort direction",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Zendesk API token in format 'email@example.com/token:{api_token}' encoded as Bearer token, or OAuth 2.0 access token"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Ticket ID"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "external_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "problem",
              "incident",
              "question",
              "task"
            ],
            "description": "Ticket type"
          },
          "subject": {
            "type": "string",
            "description": "Ticket subject line"
          },
          "raw_subject": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "First comment on the ticket"
          },
          "priority": {
            "type": "string",
            "enum": [
              "urgent",
              "high",
              "normal",
              "low"
            ],
            "description": "Ticket priority"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "open",
              "pending",
              "hold",
              "solved",
              "closed"
            ],
            "description": "Ticket status"
          },
          "requester_id": {
            "type": "integer",
            "description": "User ID of the ticket requester"
          },
          "submitter_id": {
            "type": "integer"
          },
          "assignee_id": {
            "type": "integer",
            "description": "Agent ID assigned to the ticket"
          },
          "organization_id": {
            "type": "integer"
          },
          "group_id": {
            "type": "integer"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketList": {
        "type": "object",
        "properties": {
          "tickets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ticket"
            }
          },
          "next_page": {
            "type": "string",
            "format": "uri"
          },
          "previous_page": {
            "type": "string",
            "format": "uri"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "TicketResponse": {
        "type": "object",
        "properties": {
          "ticket": {
            "$ref": "#/components/schemas/Ticket"
          }
        }
      },
      "CreateTicketRequest": {
        "type": "object",
        "required": [
          "ticket"
        ],
        "properties": {
          "ticket": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string"
              },
              "comment": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string"
                  },
                  "html_body": {
                    "type": "string"
                  }
                }
              },
              "requester_id": {
                "type": "integer"
              },
              "assignee_id": {
                "type": "integer"
              },
              "group_id": {
                "type": "integer"
              },
              "organization_id": {
                "type": "integer"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "urgent",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "new",
                  "open",
                  "pending",
                  "hold",
                  "solved"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "problem",
                  "incident",
                  "question",
                  "task"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "UpdateTicketRequest": {
        "type": "object",
        "required": [
          "ticket"
        ],
        "properties": {
          "ticket": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "new",
                  "open",
                  "pending",
                  "hold",
                  "solved",
                  "closed"
                ]
              },
              "priority": {
                "type": "string",
                "enum": [
                  "urgent",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "assignee_id": {
                "type": "integer"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "comment": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string"
                  },
                  "public": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "author_id": {
            "type": "integer"
          },
          "body": {
            "type": "string"
          },
          "html_body": {
            "type": "string"
          },
          "plain_body": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CommentList": {
        "type": "object",
        "properties": {
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "next_page": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "end-user",
              "agent",
              "admin"
            ]
          },
          "organization_id": {
            "type": "integer"
          },
          "verified": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserList": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "next_page": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrganizationList": {
        "type": "object",
        "properties": {
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organization"
            }
          },
          "next_page": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "SearchResults": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "next_page": {
            "type": "string"
          },
          "previous_page": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
