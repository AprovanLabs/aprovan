{
  "name": "@utdk/events",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared events contract for UTDK event-stream providers: append-only channels with emit/list, at-least-once semantics, and tool-discovery helpers",
  "keywords": [
    "events",
    "stream",
    "append-only",
    "utdk"
  ],
  "utdk": {
    "contract": "events",
    "handwritten": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "2.1.5"
  }
}
