{
  "name": "@utdk/vfs",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared file-plane contract for UTDK storage providers: read/write/delete/list/stat over relative paths with etag conditional writes — a minimal driver contract, no sessions/overlays/mounts",
  "keywords": [
    "vfs",
    "files",
    "storage",
    "utdk"
  ],
  "utdk": {
    "contract": "vfs",
    "handwritten": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "2.1.5"
  }
}
