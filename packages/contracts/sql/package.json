{
  "name": "@utdk/sql",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared SQL contract for UTDK database providers: one result shape, param conventions, deadline/polling helpers, and the per-backend query engines",
  "utdk": {
    "contract": "sql",
    "handwritten": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    },
    "./snowflake": {
      "types": "./dist/snowflake.d.ts",
      "import": "./dist/snowflake.js",
      "default": "./dist/snowflake.js"
    },
    "./databricks": {
      "types": "./dist/databricks.d.ts",
      "import": "./dist/databricks.js",
      "default": "./dist/databricks.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "vitest": "2.1.5"
  }
}
