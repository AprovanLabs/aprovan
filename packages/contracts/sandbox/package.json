{
  "name": "@utdk/sandbox",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared sandbox contract for UTDK execution providers: one driver surface (exec + files + ports), hash manifests for VFS sync, and the npm-package image system",
  "utdk": {
    "contract": "sandbox",
    "handwritten": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js",
      "default": "./dist/image.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "2.1.5"
  }
}
