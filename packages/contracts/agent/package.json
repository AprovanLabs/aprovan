{
  "name": "@utdk/agent",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared agent-runtime contract for UTDK: one run/get/cancel surface over any harness or vendor agent loop, a normalized effort ordinal, declared capabilities, and sandbox-shaped file ops so a workspace mount works unchanged",
  "keywords": [
    "agent",
    "runtime",
    "harness",
    "tool-use",
    "utdk"
  ],
  "utdk": {
    "contract": "agent",
    "handwritten": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "2.1.5"
  }
}
