{
  "name": "@aprovan/mcp-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Cursor and Claude plugin entrypoint for the Aprovan workspace MCP server",
  "keywords": [
    "aprovan",
    "mcp",
    "cursor",
    "claude",
    "plugin"
  ],
  "license": "MIT",
  "bin": {
    "aprovan-mcp": "./dist/bin.js"
  },
  "main": "./dist/serve.js",
  "types": "./dist/serve.d.ts",
  "exports": {
    ".": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mcp-remote": "^0.13.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
