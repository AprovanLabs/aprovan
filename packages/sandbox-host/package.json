{
  "name": "@aprovan/sandbox-host",
  "version": "0.1.0",
  "type": "module",
  "description": "Run Aprovan sandboxes on a machine you own: the @utdk/sandbox driver for registered machines, plus the executor and agent that serve them",
  "keywords": [
    "aprovan",
    "sandbox",
    "executor",
    "utdk"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@utdk/sandbox": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
