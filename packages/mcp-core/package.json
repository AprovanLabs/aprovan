{
  "name": "@utdk/mcp-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared tool catalog and meta-tool handlers for @utdk/mcp packages",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@utcp/http": "^1.1.1",
    "@utdk/common": "workspace:*"
  },
  "optionalDependencies": {
    "@utdk/airtable": "workspace:*",
    "@utdk/datadog": "workspace:*",
    "@utdk/figma": "workspace:*",
    "@utdk/github": "workspace:*",
    "@utdk/hubspot": "workspace:*",
    "@utdk/intercom": "workspace:*",
    "@utdk/jira": "workspace:*",
    "@utdk/linear": "workspace:*",
    "@utdk/notion": "workspace:*",
    "@utdk/openai": "workspace:*",
    "@utdk/salesforce": "workspace:*",
    "@utdk/sendgrid": "workspace:*",
    "@utdk/slack": "workspace:*",
    "@utdk/spotify": "workspace:*",
    "@utdk/stripe": "workspace:*",
    "@utdk/twilio": "workspace:*",
    "@utdk/zendesk": "workspace:*",
    "utdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
