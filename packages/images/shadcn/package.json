{
  "name": "@aprovan/patchwork-image-shadcn",
  "version": "0.1.4",
  "description": "Patchwork image: ShadCN/ui with Tailwind CSS and Radix UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "DESIGN.md",
    "PROMPT.md",
    "dist",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "sync-components": "node scripts/sync-components.mjs",
    "check-components": "node scripts/sync-components.mjs --check"
  },
  "patchwork": {
    "platform": "browser",
    "prompt": "./PROMPT.md",
    "docs": {
      "design": "./DESIGN.md"
    },
    "dependencies": {
      "react": "^18.0.0",
      "react-dom": "^18.0.0"
    },
    "esbuild": {
      "target": "es2022",
      "format": "esm",
      "jsx": "transform",
      "jsxFactory": "React.createElement",
      "jsxFragment": "React.Fragment"
    },
    "framework": {
      "globals": {
        "react": "React",
        "react-dom": "ReactDOM"
      },
      "preload": [
        "https://esm.sh/react@18",
        "https://esm.sh/react-dom@18/client"
      ],
      "deps": {
        "react": "18",
        "react-dom": "18"
      }
    },
    "aliases": {
      "@/components/ui/*": "@packagedcn/react",
      "@/components/*": "@packagedcn/react",
      "@/lib/utils": "@packagedcn/react"
    },
