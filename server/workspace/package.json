{
  "name": "@aprovan/workspace",
  "version": "0.2.0",
  "type": "module",
  "description": "The Aprovan workspace — chat, apps, workflows, MCP, and the credential/permission gateway in one process",
  "license": "MIT",
  "bin": {
    "workspace": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts start",
    "dev:aws": "WORKSPACE_MODE=aws DYNAMO_ENDPOINT=http://localhost:8000 S3_ENDPOINT=http://localhost:9000 FS_BUCKET=aprovan-fs tsx watch src/cli.ts start",
    "bootstrap:local": "tsx scripts/bootstrap-local.ts",
    "gc-blobs": "tsx scripts/gc-blobs.ts",
    "build": "tsc -p tsconfig.json && cp src/db/dsql-schema.sql dist/db/dsql-schema.sql",
    "check-types": "tsc -p tsconfig.json --noEmit && tsx scripts/check-effect-completeness.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsx scripts/check-effect-completeness.ts",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "create-tables": "tsx bin/create-tables.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aprovan/agent-protocol": "workspace:*",
    "@aprovan/native": "workspace:*",
    "@aprovan/node": "workspace:*",
    "@aprovan/patchwork": "workspace:*",
    "@aprovan/registry-server": "^0.2.11",
    "@aws-sdk/client-cognito-identity-provider": "^3.1077.0",
    "@aws-sdk/client-dynamodb": "^3.1077.0",
    "@aws-sdk/client-kms": "^3.1077.0",
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/client-ses": "^3.1077.0",
    "@aws-sdk/lib-dynamodb": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.8.0",
    "@jitl/quickjs-wasmfile-debug-asyncify": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@utdk/agent": "^0.2.0",
    "@utdk/clients": "^0.1.3",
    "@utdk/common": "^0.1.2",
    "@utdk/events": "^0.2.1",
    "@utdk/keyvalue": "^0.2.1",
    "@utdk/llm": "^0.2.0",
    "@utdk/mcp-core": "^0.1.0",
    "@utdk/remote": "0.1.4",
    "@utdk/sandbox": "^0.2.1",
    "@utdk/sql": "^0.2.0",
    "@utdk/stt": "^0.1.2",
    "@utdk/telemetry": "^0.3.1",
    "@utdk/vcs": "^0.2.1",
    "@utdk/vfs": "^0.2.1",
    "aws-jwt-verify": "^4.0.1",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.6.20",
    "quickjs-emscripten-core": "0.32.0",
    "tslib": "^2.8.1",
    "ulid": "^3.0.2",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@aws-sdk/dsql-signer": "^3.1077.0",
    "pg": "^8.22.0"
  }
}
