# Point a local process at the deployed AWS backends. Not needed for ordinary
# local development — `workspace start` defaults to WORKSPACE_MODE=local and
# needs no configuration at all.
#
# Shared Cognito/identity tables load from SSM (APROVAN_ENVIRONMENT). The
# registry-specific DynamoDB tables are not in that parameter — set them here.
WORKSPACE_MODE=aws
APROVAN_ENVIRONMENT=prd
WORKSPACE_PORT=4000
AWS_REGION=us-east-2

SESSIONS_TABLE=registry-prd-use2-sessions
CREDENTIALS_TABLE=registry-prd-use2-credentials
PERMISSIONS_TABLE=registry-prd-use2-permissions
AUDIT_TABLE=registry-prd-use2-audit-store
GROUPS_TABLE=registry-prd-use2-groups
GROUP_PREFIX_GRANTS_TABLE=registry-prd-use2-group-prefix-grants
GROUP_TOOL_GRANTS_TABLE=registry-prd-use2-group-tool-grants
USER_GROUPS_TABLE=registry-prd-use2-user-groups
USERGROUPS_TABLE=registry-prd-use2-user-groups
FS_TABLE=registry-prd-use2-fs-files
FS_BUCKET=registry-prd-use2-workspace-fs
RECORDS_TABLE=registry-prd-use2-records
