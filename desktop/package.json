{
  "name": "@aprovan/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aprovan desktop shell — Electron host for the local workspace gateway and shared web client",
  "license": "MIT",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "electron": "^33.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
