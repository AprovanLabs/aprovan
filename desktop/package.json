{
  "name": "@aprovan/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aprovan desktop shell — Electron host for the local workspace gateway and shared web client",
  "license": "MIT",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsup && bash scripts/prepare-resources.sh",
    "build:main": "tsup",
    "bundle:renderer": "bash scripts/bundle-renderer.sh",
    "vendor:gateway": "bash scripts/vendor-gateway.sh",
    "assert:gateway": "bash scripts/assert-gateway.sh",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist build/bundles build/gateway build/runtime release",
    "dev": "DESKTOP_SKIP_RESOURCES=1 pnpm build:main && electron .",
    "start": "electron .",
    "test": "vitest run",
    "dist": "electron-builder --config electron-builder.yml --mac --arm64",
    "dist:dir": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --mac --arm64 --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
