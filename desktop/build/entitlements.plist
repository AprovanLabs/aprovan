<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Electron / Chromium V8 requires JIT under Hardened Runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Electron internals allocate executable pages that are not JIT regions. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!--
	  Required so the shell can load Electron frameworks and spawn the
	  bundled stock Node runtime + gateway helpers + macos-helper that are
	  re-signed as nested binaries (not App Store sandboxed). Deliberately
	  omit com.apple.security.app-sandbox — local agent execution needs
	  process spawn outside the sandbox (desktop-shell tech-plan D4).
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!--
	  Native capabilities (macos-native-providers):

	  On-device model (FoundationModels / SystemLanguageModel.default):
	  No Hardened Runtime or developer entitlement is required for the
	  system default model. Custom adapters would need
	  com.apple.developer.foundation-model-adapter (not used). The helper
	  binary is signed as a nested executable under entitlementsInherit;
	  availability is still gated by OS floor + Apple Intelligence settings.

	  Notification centre (Electron Notification → UNUserNotificationCenter):
	  No Hardened Runtime entitlement applies. Presentation is gated by the
	  user's Notification permission (TCC) requested on first use; denial is
	  non-fatal (stream 4). The main app must remain Developer ID–signed /
	  notarized for reliable delivery outside a local unsigned build.
	-->
</dict>
</plist>
