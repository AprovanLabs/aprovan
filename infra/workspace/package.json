  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "CDK infrastructure for the Aprovan registry gateway",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
