    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^25.5.0",
    "aws-cdk": "^2.180.0",
    "esbuild": "^0.25.6",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  }
}
