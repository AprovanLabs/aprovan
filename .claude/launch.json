{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "patchwork-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@aprovan/patchwork-web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "patchwork-web-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "APROVAN_ENV=off",
        "pnpm",
        "--filter",
        "@aprovan/patchwork-web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "gateway-local-scratch",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "APROVAN_ENV=off",
        "WORKSPACE_MODE=local",
        "WORKSPACE_PORT=4010",
        "WORKSPACE_DATA_DIR=/tmp/patchwork-gateway-scratch",
        "pnpm",
        "--filter",
        "@aprovan/workspace",
        "exec",
        "tsx",
        "src/cli.ts",
        "start"
      ],
      "port": 4010
    },
    {
      "name": "patchwork-web-scratch",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "APROVAN_ENV=off",
        "GATEWAY_URL=http://localhost:4010/api/gateway",
        "pnpm",
        "--filter",
        "@aprovan/patchwork-web",
        "dev",
        "--port",
        "5199"
      ],
      "port": 5199
    },
    {
      "name": "patchwork-web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@aprovan/patchwork-web",
        "preview",
        "--port",
        "4173"
      ],
      "port": 4173
    }
  ]
}
