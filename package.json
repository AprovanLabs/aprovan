{
  "name": "@aprovan/aprovan-monorepo",
  "private": true,
  "version": "0.1.1",
  "description": "Platform for building generative UI experiences",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev --parallel",
    "lint": "eslint \"**/*.ts?(x)\"",
    "lint:fix": "eslint --fix \"**/*.ts?(x)\"",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules packages/*/node_modules packages/*/dist",
    "deploy": "scripts/deploy.sh",
    "deploy:web": "scripts/deploy-web.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-tsdoc": "^0.5.0",
    "globals": "^15.0.0",
    "lint-staged": "^13.0.3",
    "prettier": "^3.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "2.1.5"
  },
  "prettier": "./.prettierrc.json",
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,md,scss}": "prettier --write"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@utdk/common": "workspace:*",
      "@utdk/mcp-core": "workspace:*"
    }
  }
}
